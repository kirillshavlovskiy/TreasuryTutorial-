# NextAuth (Auth.js) Google login.
# Local:      copy to .env.local and fill in the values.
# Production: see .env.prod.example → copy to .env.prod (gitignored) and fill secrets.

# Generate with: openssl rand -base64 33
# Auth.js also accepts NEXTAUTH_SECRET as an alias.
AUTH_SECRET=

# Canonical site URL. Shared by Google login (Auth.js) and the Treasury Okta
# redirect_uri builder. Required in production — the app refuses to derive it
# from the Host header there. Auth.js also accepts NEXTAUTH_URL as an alias.
# Local: http://localhost:3000
# Production: https://ssigma.app
AUTH_URL=http://localhost:3000

# Google OAuth credentials — create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins:
#   http://localhost:3000
#   https://ssigma.app
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://ssigma.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Fallbacks if AUTH_GOOGLE_* are unset (auth.ts).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Corporate proxy / SSL inspection (local dev only; ignored in production)
# AUTH_ALLOW_INSECURE_TLS=true
# Written by auth.ts when AUTH_ALLOW_INSECURE_TLS=true. Do not set by hand.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Simple Sigma Test Dashboard (Sigma Tasks sandbox) ───────────────────────
# Always on in every environment (lib/test-mode/enabled.ts). The old
# TEST_MODE_ENABLED / TEST_MODE_ALLOW_PROD flags are no longer read.

# ── Local development stack ────────────────────────────────────────────────
# `npm run dev` starts Postgres, Redis and MinIO through docker compose first
# (the `predev` script → scripts/local-stack.mjs) and then fills in these keys
# in .env.local, WITHOUT ever overwriting a value you have already set:
#   DATABASE_URL  REDIS_URL  S3_ENDPOINT  S3_BUCKET  S3_PREFIX  S3_REGION
#   AWS_ACCESS_KEY_ID  AWS_SECRET_ACCESS_KEY   (pointed at the local MinIO)
#   AUTH_SECRET                                (generated only when empty)
# It never generates TOKEN_ENCRYPTION_KEY — inventing one would orphan every
# Treasury token already encrypted in the shared database.
# If a key is assigned twice, or sits inside an unclosed quoted value, the
# script refuses to touch it and says so rather than guessing.
# See README.md → "Local development stack".
#
# Host ports are overridable if something on your machine already has them.
# Those overrides are read by the SCRIPT, not by the app, so they are not part
# of this file's variable list and are not written to .env.local — pass them in
# the shell instead. Defaults, and what each one moves:
#   FX_PG_PORT            (5432)   Postgres
#   FX_REDIS_PORT         (16379)  Redis — 6379 is often taken by another project
#   FX_MINIO_PORT         (9000)   MinIO S3 API
#   FX_MINIO_CONSOLE_PORT (9001)   MinIO web console
#   STACK_SKIP            (unset)  set to 1 to skip the stack entirely
#
# ── PostgreSQL (sandbox + desk snapshots, leg tape ticks) ───────────────────
# Local: docker-compose Postgres, or any reachable Postgres URL.
# Production / Vercel: Neon (or other managed Postgres). Neon hosts automatically
# use the HTTPS/WSS driver on :443 (lib/db/sequelize.ts) when the URL matches
# neon.tech / neon.build — plain pg-wire otherwise.
# Data is partitioned by table:
#   sandbox_progress_uat | sandbox_progress_production
#   desk_workspace_* | desk_fx_book_* | desk_liquidity_*
#   desk_analytics_* | desk_hedge_* | desk_action_* | leg_tape_ticks
# Auto: VERCEL_ENV=production → production table; preview/local → uat.
# Override: SANDBOX_STORAGE_ENV=uat|production|local
# Without any URL, sandbox / desk still persist in the browser only.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/fx_test_project

# The connection string is taken from the first of these that is set, in order
# (lib/db/sequelize.ts → resolveDatabaseUrl). The Neon/Vercel Marketplace
# integration injects the ssigma_* names instead of the plain ones, so all four
# are accepted. Set only one.
#   1. DATABASE_URL   2. ssigma_DATABASE_URL   3. POSTGRES_URL   4. ssigma_POSTGRES_URL
# POSTGRES_URL=
# ssigma_DATABASE_URL=
# ssigma_POSTGRES_URL=

# Outbound TCP :5432 is often blocked on corp Windows (EACCES). Neon hosts
# automatically use the HTTPS/WSS driver on :443 instead of pg-wire.
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# SANDBOX_STORAGE_ENV=local

# IP family for the pg connection: "6" selects IPv6, anything else selects IPv4.
# Defaults to IPv4. Set this only if the host resolves to an unreachable family.
# DATABASE_IP_FAMILY=4

# ── Redis ───────────────────────────────────────────────────────────────────
# Provided by the local stack, and injected in the cluster as
# redis://<sandbox>-redis:6379 — but only once a Redis client is a dependency,
# which it is not today (see README.md → "Local development stack"). NOTHING in
# this codebase reads this variable yet. It is here so the local value and the
# cluster value have the same shape when something does.
# REDIS_URL=redis://localhost:16379

# ── AI Agent (Workbench chat panel) ──────────────────────────────────────────
# Google Gemini API key — free tier, no credit card required.
# Create one at https://aistudio.google.com/apikey
# Note: free-tier requests may be used by Google to improve their products;
# do not send confidential data through the agent on the free tier.
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Recorded-tape store ─────────────────────────────────────────────────────
# Which store the matcher writes the recorded tape to, and reads it back from.
# Exactly one, never both: "s3" (the execution journal) or "postgres"
# (leg_tape_ticks). Unset means s3, which is what the cluster runs.
# A local checkout has DATABASE_URL but usually no AWS credentials, so set
# postgres here — otherwise every 1s beat fails an S3 put forever.
# EXECUTION_STORE=postgres

# ── AWS S3 file storage (playground bucket) ─────────────────────────────────
# Cluster: IRSA via Helm service account (no static keys).
# Local: `npm run dev` points the client at MinIO (S3_ENDPOINT below). There
#        are no laptop credentials for the real bucket. Without any S3,
#        market-rate uploads still parse + persist in the book, but the
#        execution journal is not saved (the browser console says so once).
# Bucket access is restricted to the fx-test-project/ prefix.
S3_BUCKET=deel-playgrounds-data
S3_PREFIX=fx-test-project/
S3_REGION=eu-west-1

# S3-compatible endpoint to use INSTEAD of AWS. The local stack points this at
# MinIO; setting it also switches the client to path-style addressing, which
# MinIO needs and AWS does not. Leave it UNSET in the cluster — there the
# bucket is real AWS S3 reached through IRSA.
# S3_ENDPOINT=http://localhost:9000
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# The only supported credential sources are IRSA (in-cluster) and the static
# AWS_* vars above (local). EC2 instance metadata is never valid here, but the
# SDK still probes it last and logs a noisy MetadataLookupWarning. The app sets
# this to "true" itself when it is unset (lib/s3.ts). Set it to "false" only to
# deliberately opt the metadata probe back in.
# AWS_EC2_METADATA_DISABLED=true

# ── Treasury OAuth (Okta) + Finance MCP ─────────────────────────────────────
# Powers the "Connect Treasury" flow and the live NP cash overlay. Without
# this whole block the app still runs: the book shows its static values and
# the header badge reads "Connect Treasury" instead of going live.

# Okta custom Authorization Server that issues the Finance MCP token, and this
# app's own confidential (Web) OIDC client registered under it.
# Requested scopes are openid + email + offline_access + finance_mcp:access —
# they must ALL be listed on the AS access policy rule, or Okta matches no rule
# and answers `access_denied` at /authorize with nothing naming the extra scope.
OKTA_ISSUER=https://deel.okta.com/oauth2/<auth-server-id>
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# Treasury Finance MCP endpoint (Streamable HTTP, POST /mcp).
# Use the PUBLIC host. Internal `*.deel` names resolve only on the corporate
# network/VPN (treasury.prod.deel is 100.64.0.9, a CGNAT address), so a cloud
# runtime fails them with `getaddrinfo ENOTFOUND` — which surfaces in the UI
# only as the generic "Treasury data unavailable" badge.
TREASURY_MCP_URL=https://treasury.deel.network/mcp

# AES-256-GCM key encrypting stored OAuth tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Optional, rotation grace period only: the previous key, tried when the
# current one fails to decrypt. Drop it once every row has been re-saved.
# TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Canonical origin for Treasury Okta is AUTH_URL above. Locally, if AUTH_URL
# is omitted, the request origin is used — so
# http://localhost:3000/api/treasury/oauth/callback must also be registered
# as a Login redirect URI on the Okta app.

# ── Background matching service (tape walking + order fill detection) ──────────
# Interval between tape ticks when the background matching service is running.
# In milliseconds. Default: 100 (ten ticks per second). Set this only to override
# for testing or if you want slower/faster tape simulation.
# TAPE_INTERVAL_MS=100

# Local dev only, not read by the app: Node reads its own CA store and ignores
# the macOS keychain, so a corporate TLS-inspecting agent (Aikido
# EndpointProtection) makes the dev server fail MCP calls with
# SELF_SIGNED_CERT_IN_CHAIN while the same URL works fine in the browser.
# Point Node at the agent's bundle when starting the dev server:
# NODE_EXTRA_CA_CERTS="/Library/Application Support/AikidoSecurity/EndpointProtection/run/endpoint-protection-node-combined-ca.pem"

# --- Live FX (overlay handover: exchangerate.dev, optional) ---
# Anonymous GET https://api.exchangerate.dev/v1/latest/{BASE}?symbols={QUOTE}
# is enough for one tab (100 req/hour/IP). Optional Bearer raises the cap.
# EXCHANGERATE_DEV_API_KEY=
# NEXT_PUBLIC_EXCHANGERATE_DEV_API_KEY=
