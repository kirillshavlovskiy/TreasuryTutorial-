# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env.vercel

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling / archives
.claude.zip
# working files written by the fx-ship skill (diff snapshots)
.claude/tmp/
# .cursor/ holds both shared team config and per-machine state. Ignore it by
# default, then un-ignore only the parts that are meant to be committed.
.cursor/*
!.cursor/hooks.json
!.cursor/hooks/*.mjs
!.cursor/hooks/*.test.ts
!.cursor/rules/*.mdc
.test-trigger
.DS_Store
.tmp-handover*/
.tmp-compare/
scripts/scratch/
handover-*/

# production secrets (use .env.prod.example as the template)
.env.prod

