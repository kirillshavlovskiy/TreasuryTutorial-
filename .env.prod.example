# ═══════════════════════════════════════════════════════════════════════════
# Production environment — Simple Sigma / fx-test-project
# ═══════════════════════════════════════════════════════════════════════════
# Fill secrets from AWS Secrets Manager / Vercel / cluster secret store.
# Do NOT commit real credentials. This file is gitignored (.env.prod).
#
# Canonical host (Helm ingress): https://fx-test-project.dp.com
# Product alias (if used):       https://ssigma.app
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=production
VERCEL_ENV=production

# ── Google OAuth via login.dp.com ────────────────────────────────────────────
# HMAC signing secret for this app's session cookie.
# Generate: openssl rand -base64 33
AUTH_SECRET=

# Shared OAuth client and this project's login.dp.com routing ID.
# Also required in AWS Secrets Manager (`fx-test-project`) for the cluster.
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_PROJECT_ID=

# Platform proxy URL that Google redirects to after sign-in.
# Same value in local development and production (Helm also injects this).
GOOGLE_REDIRECT_URI=https://login.dp.com/api/gcp-oauth/callback

# Optional. Leave UNSET in the cluster: the app derives its own callback from the
# forwarded host, so both ingress.host and aliasHost (ssigma.dp.com) work.
# NEXTAUTH_URL=https://fx-test-project.dp.com

# ── Sigma Tasks / practice sandbox ──────────────────────────────────────────
# Always on in every environment (lib/test-mode/enabled.ts). The old
# TEST_MODE_ENABLED / TEST_MODE_ALLOW_PROD flags are no longer read.

# ── PostgreSQL (sandbox progress) ───────────────────────────────────────────
# Production table: sandbox_progress_production
# Prefer cluster/Neon secret injection over baking the URL into this file.
SANDBOX_STORAGE_ENV=production
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Primary connection (Neon / cluster). Example:
# DATABASE_URL=postgres://USER:PASS@HOST/neondb?sslmode=require
DATABASE_URL=

# Marketplace / alternate inject names (app resolves any of these):
# ssigma_DATABASE_URL=
# POSTGRES_URL=
# ssigma_POSTGRES_URL=

# Unpooled URL only if migrations need it (optional):
# DATABASE_URL_UNPOOLED=

# ── AWS S3 file storage ─────────────────────────────────────────────────────
# Cluster: IRSA on the service account — leave AWS_* keys unset.
# Access is restricted to the fx-test-project/ prefix.
S3_BUCKET=deel-playgrounds-data
S3_PREFIX=fx-test-project/
S3_REGION=eu-west-1
AWS_REGION=eu-west-1

# Static keys only if running outside IRSA (avoid in prod cluster):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── Optional ops ────────────────────────────────────────────────────────────
# LOG_LEVEL=info
