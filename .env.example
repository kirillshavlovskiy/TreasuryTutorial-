# NextAuth (Auth.js) configuration.
# Copy to .env.local and fill in the values.

# Generate with: openssl rand -base64 33
AUTH_SECRET=

# Canonical site URL (required on Vercel / production).
# Local: http://localhost:3000
# Production: https://ssigma.app
AUTH_URL=http://localhost:3000

# Google OAuth credentials — create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins:
#   http://localhost:3000
#   https://ssigma.app
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://ssigma.app/api/auth/callback/google
# auth.ts also accepts GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET as fallbacks.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Corporate proxy / SSL inspection (local dev only)
# AUTH_ALLOW_INSECURE_TLS=true

# ── Simple Sigma Test Dashboard (Sigma Tasks sandbox) ───────────────────────
# Enables /test practice sandbox. Off in production unless
# TEST_MODE_ALLOW_PROD=true is also set.
TEST_MODE_ENABLED=true
# TEST_MODE_ALLOW_PROD=false

# ── PostgreSQL (sandbox progress across login sessions / devices) ───────────
# Same Neon connection for UAT + production; data is partitioned by table:
#   sandbox_progress_uat | sandbox_progress_production
# Auto: VERCEL_ENV=production → production table; preview/local → uat.
# Override: SANDBOX_STORAGE_ENV=uat|production
# Vercel Marketplace may inject ssigma_DATABASE_URL — the app accepts that too.
# Without any URL, sandbox still persists in the browser only.
# DATABASE_URL=postgres://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# SANDBOX_STORAGE_ENV=uat
