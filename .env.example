# Google OAuth through the Deel login.dp.com platform proxy.
# Local:      copy to .env.local and fill in the values.
# Production: see .env.prod.example → copy to .env.prod (gitignored) and fill secrets.

# HMAC signing secret for this app's session cookie.
# Generate with: openssl rand -base64 33
AUTH_SECRET=

# Shared Google OAuth client and this project's platform routing ID.
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_PROJECT_ID=

# Platform proxy URL that Google redirects to after sign-in.
# Same value in local development and production.
GOOGLE_REDIRECT_URI=https://login.dp.com/api/gcp-oauth/callback

# Optional. Used to build this app's callback URL
# (${NEXTAUTH_URL}/api/auth/callback). When omitted, the request origin is used.
# NEXTAUTH_URL=http://localhost:3000

# ── Simple Sigma Test Dashboard (Sigma Tasks sandbox) ───────────────────────
# Always on in every environment (lib/test-mode/enabled.ts). The old
# TEST_MODE_ENABLED / TEST_MODE_ALLOW_PROD flags are no longer read.

# ── PostgreSQL (sandbox + desk snapshots across login sessions / devices) ──
# Same Neon connection for UAT + production; data is partitioned by table:
#   sandbox_progress_uat | sandbox_progress_production
#   desk_workspace_* | desk_fx_book_* | desk_liquidity_*
#   desk_analytics_* | desk_hedge_* | desk_action_*
# Auto: VERCEL_ENV=production → production table; preview/local → uat.
# Override: SANDBOX_STORAGE_ENV=uat|production
# Without any URL, sandbox / desk still persist in the browser only.
# DATABASE_URL=postgres://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require

# The connection string is taken from the first of these that is set, in order
# (lib/db/sequelize.ts → resolveDatabaseUrl). The Neon/Vercel Marketplace
# integration injects the ssigma_* names instead of the plain ones, so all four
# are accepted. Set only one.
#   1. DATABASE_URL   2. ssigma_DATABASE_URL   3. POSTGRES_URL   4. ssigma_POSTGRES_URL
# POSTGRES_URL=
# ssigma_DATABASE_URL=
# ssigma_POSTGRES_URL=

# Outbound TCP :5432 is often blocked on corp Windows (EACCES). Neon hosts
# automatically use the HTTPS/WSS driver on :443 instead of pg-wire.
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# SANDBOX_STORAGE_ENV=uat

# IP family for the pg connection: "6" selects IPv6, anything else selects IPv4.
# Defaults to IPv4. Set this only if the host resolves to an unreachable family.
# DATABASE_IP_FAMILY=4

# ── AI Agent (Workbench chat panel) ──────────────────────────────────────────
# Google Gemini API key — free tier, no credit card required.
# Create one at https://aistudio.google.com/apikey
# Note: free-tier requests may be used by Google to improve their products;
# do not send confidential data through the agent on the free tier.
GOOGLE_GENERATIVE_AI_API_KEY=

# ── AWS S3 file storage (playground bucket) ─────────────────────────────────
# Cluster: IRSA via Helm service account (no static keys).
# Local: export AWS credentials that can read/write under the prefix, or omit
#        S3 entirely — market-rate uploads still parse + persist in the book.
# Bucket access is restricted to the fx-test-project/ prefix.
S3_BUCKET=deel-playgrounds-data
S3_PREFIX=fx-test-project/
S3_REGION=eu-west-1
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# The only supported credential sources are IRSA (in-cluster) and the static
# AWS_* vars above (local). EC2 instance metadata is never valid here, but the
# SDK still probes it last and logs a noisy MetadataLookupWarning. The app sets
# this to "true" itself when it is unset (lib/s3.ts). Set it to "false" only to
# deliberately opt the metadata probe back in.
# AWS_EC2_METADATA_DISABLED=true

# ── Treasury OAuth (Okta) + Finance MCP ─────────────────────────────────────
# Powers the "Connect Treasury" flow and the live NP cash overlay. Without
# this whole block the app still runs: the book shows its static values and
# the header badge reads "Connect Treasury" instead of going live.

# Okta custom Authorization Server that issues the Finance MCP token, and this
# app's own confidential (Web) OIDC client registered under it.
# Requested scopes are openid + email + offline_access + finance_mcp:access —
# they must ALL be listed on the AS access policy rule, or Okta matches no rule
# and answers `access_denied` at /authorize with nothing naming the extra scope.
OKTA_ISSUER=https://deel.okta.com/oauth2/<auth-server-id>
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# Treasury Finance MCP endpoint (Streamable HTTP, POST /mcp).
# Use the PUBLIC host. Internal `*.deel` names resolve only on the corporate
# network/VPN (treasury.prod.deel is 100.64.0.9, a CGNAT address), so a cloud
# runtime fails them with `getaddrinfo ENOTFOUND` — which surfaces in the UI
# only as the generic "Treasury data unavailable" badge.
TREASURY_MCP_URL=https://treasury.deel.network/mcp

# AES-256-GCM key encrypting stored OAuth tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Optional, rotation grace period only: the previous key, tried when the
# current one fails to decrypt. Drop it once every row has been re-saved.
# TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Canonical origin used to build the OAuth redirect_uri and post-flow
# redirects. REQUIRED in production — the app refuses to derive it from the
# client-controlled Host header there. Omitted locally, the request origin
# is used, so http://localhost:3000/api/treasury/oauth/callback must also be
# registered as a Login redirect URI on the Okta app.
# AUTH_URL=https://ssigma.dp.com

# Local dev only, not read by the app: Node reads its own CA store and ignores
# the macOS keychain, so a corporate TLS-inspecting agent (Aikido
# EndpointProtection) makes the dev server fail MCP calls with
# SELF_SIGNED_CERT_IN_CHAIN while the same URL works fine in the browser.
# Point Node at the agent's bundle when starting the dev server:
# NODE_EXTRA_CA_CERTS="/Library/Application Support/AikidoSecurity/EndpointProtection/run/endpoint-protection-node-combined-ca.pem"
