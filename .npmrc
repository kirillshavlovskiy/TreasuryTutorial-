# Supply-chain guard: never RESOLVE a version published less than 7 days ago.
#
# The config key is `min-release-age` and its unit is DAYS — npm implements it as
# `before = now - 86400000 * n`. It is mutually exclusive with `before`; setting
# both fails with "--min-release-age cannot be provided when using --before".
#
# Why: a compromised maintainer account surfaces as a freshly published patch
# version, and the window between publication and the registry pulling it is
# usually hours to a couple of days. Waiting 7 days means this project is never
# the first to find out.
#
# ── REQUIRES npm >= 11.10.0. Older npm ignores this file's whole point ──────
#
# Measured: npm 11.9.0 prints `Unknown project config "min-release-age"` and
# then installs a 3-day-old package anyway. npm 11.10.0 refuses it. A warning
# nobody reads is not a guard, so `engines.npm` in package.json requires
# >= 11.10.0 and `engine-strict` below turns a mismatch into a hard failure
# rather than another ignorable warning. The CI/Docker base image
# (node:24-alpine) ships npm 11.19.0.
engine-strict=true
#
# ── What it covers, measured rather than assumed ────────────────────────────
#
# Against a package published 3 days ago:
#   npm install @types/node@26.5.0   -> ETARGET, "no matching version ... with a
#                                        date before <cutoff>"
#   npm install @types/node@^26.0.0  -> resolves 26.4.1 (newest >= 7d), no error
#
# `npm ci` is NOT covered — it reads the lockfile verbatim, so a lockfile already
# pinning a 3-day-old version installs it with exit 0 (measured). CI
# (.github/workflows/pre-deploy-test.yml) and the Dockerfile BUILDER stage both
# use `npm ci`, so they neither break nor benefit.
#
# The Dockerfile RUNNER stage is different and is covered: line 16 copies this
# file into the image and line 17 runs `npm install --no-save pg pg-hstore
# @opentelemetry/...`, which is a real resolution with no lockfile. A pin that
# needed an escape hatch locally can therefore fail inside `docker build`, where
# there is nowhere to pass a flag — which is the reason to prefer the exclude
# below over a command-line override.
#
# ── The cost, which is real and has already bitten ──────────────────────────
#
# A security patch published today cannot be installed for 7 days either. This
# is not hypothetical: hono 4.13.7 (6 days old) is blocked right now, and the
# advisory is cleared instead by 4.13.5 (16 days old), which is what the
# overrides pin. When only a too-new version fixes something, prefer a scoped,
# committed exemption over a blanket bypass:
#
#     min-release-age-exclude=<package-name>
#
# That key exists in npm >= 11.17 (measured: absent in 11.16.0, present in
# 11.17.0) and travels with the repo, so it also works in
# the Docker runner stage. It is deliberately NOT set here — add a package to it
# only with a reason in the commit, and remove it when the version has aged out.
# (The dev machine that wrote this ran npm 11.11.0, which does not have the key;
# CI's 11.19.0 does. Check `npm config ls -l | grep min-release-age` locally
# before relying on it.)
#
# The last resort, for one command on one machine, is `--min-release-age=0`. It
# drops the floor for every package that command resolves, not just the one you
# meant, so reach for the exclude first.
min-release-age=7
